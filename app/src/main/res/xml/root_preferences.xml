<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <Preference
        app:key="lift"
        app:title="@string/lift_preferences_title"
        app:summary="@string/lift_preferences_summary"
        app:fragment="com.lift.app.fragments.settings.LiftPreferencesFragment"/>

    <Preference
        app:key="lift_api"
        app:title="@string/lift_api_preferences_title"
        app:summary="@string/lift_api_preferences_summary"
        app:isPreferenceVisible="false"
        app:fragment="com.lift.app.fragments.settings.LiftAPIPreferencesFragment"/>

    <Preference
        app:key="lift_float"
        app:title="@string/lift_float_preferences_title"
        app:summary="@string/lift_float_preferences_summary"
        app:isPreferenceVisible="false"
        app:fragment="com.lift.app.fragments.settings.LiftFloatPreferencesFragment"/>

    <Preference
        app:key="lift_tasker"
        app:title="@string/lift_tasker_preferences_title"
        app:summary="@string/lift_tasker_preferences_summary"
        app:isPreferenceVisible="false"
        app:fragment="com.lift.app.fragments.settings.LiftTaskerPreferencesFragment"/>

    <Preference
        app:key="lift_widget"
        app:title="@string/lift_widget_preferences_title"
        app:summary="@string/lift_widget_preferences_summary"
        app:isPreferenceVisible="false"
        app:fragment="com.lift.app.fragments.settings.LiftWidgetPreferencesFragment"/>

    <Preference
        app:key="about"
        app:title="@string/about_preference_title"
        app:persistent="false"/>
    <!-- app:layout="@layout/preference_markdown_text" -->

    <Preference
        app:key="donate"
        app:title="@string/donate_preference_title"
        app:persistent="false"
        app:isPreferenceVisible="false"/>

</PreferenceScreen>
